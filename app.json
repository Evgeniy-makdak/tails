{
  "expo": {
    "name": "Хвостик",
    "slug": "hvostik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "hvostik",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hvostik.app",
      "infoPlist": {
        "CFBundleDisplayName": "Хвостик",
        "NSCameraUsageDescription": "Хвостик использует камеру, чтобы прикрепить фото питомца в чат со специалистом.",
        "NSPhotoLibraryUsageDescription": "Хвостик использует галерею для вложений в чат и профиля питомца.",
        "NSMicrophoneUsageDescription": "Хвостик использует микрофон для голосового набора в чате."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F1E8"
      },
      "package": "com.hvostik.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Хвостик",
      "shortName": "Хвостик",
      "themeColor": "#8B7FFF",
      "backgroundColor": "#FFFFFF",
      "output": "single",
      "display": "standalone",
      "lang": "ru"
    },
    "experiments": {
      "baseUrl": "/tails"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Хвостик использует галерею для вложений в чат.",
          "cameraPermission": "Хвостик использует камеру для вложений в чат.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
